    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "40084877"
  },
  "item": [
    {
      "name": "1. List all users",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1/admin/files/users",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "admin",
            "files",
            "users"
          ]
        },
        "description": "Retorna uma lista com os IDs de todos os usuários que possuem arquivos no sistema."
      },
      "response": []
    },
    {
      "name": "2. List user files",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1/admin/files/users/:userId",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "admin",
            "files",
            "users",
            ":userId"
          ],
          "variable": [
            {
              "key": "userId",
              "value": "cole-o-id-do-usuario-aqui",
              "description": "ID do usuário que você deseja auditar"
            }
          ]
        },
        "description": "Retorna o histórico completo de arquivos de um usuário específico."
      },
      "response": []
    },
    {
      "name": "3. Force reprocess",
      "request": {
        "method": "POST",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1/admin/files/:fileId/reprocess",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "admin",
            "files",
            ":fileId",
            "reprocess"
          ],
          "variable": [
            {
              "key": "fileId",
              "value": "id-do-arquivo",
              "description": "ID do arquivo que falhou ou precisa ser processado novamente"
            }
          ]
        },
        "description": "Comando administrativo para reenviar o arquivo para a fila de processamento."
      },
      "response": []
    },
    {
      "name": "4. Delete file (Admin)",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1/admin/files/:fileId",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "admin",
            "files",
            ":fileId"
          ],
          "variable": [
            {
              "key": "fileId",
              "value": "id-do-arquivo",
              "description": "ID do arquivo a ser removido pelo moderador"
            }
          ]
        },
        "description": "Remove um arquivo do sistema (via GSI), independente de quem seja o dono."
      },
      "response": []
    },
